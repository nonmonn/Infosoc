generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Catalogo de los pictogramas disponibles
model Pictograma {
  id          Int         @id @default(autoincrement())
  titulo       String      // ej: "Girar a la derecha", "Baño", "Ascensor"
  imagenUrl    String      // La ruta de la imagen o el nombre del archivo
  pasosRuta  PasoRuta[] // Relación con los pasos donde se usa
}

// 2. Las rutas lógicas del hospital
model Ruta {
  id          Int         @id @default(autoincrement())
  nombre      String      // ej: "Entrada Principal a Urgencias"
  origen      String      // ej: "Entrada Principal"
  destino     String      // ej: "Urgencias"
  pasos       PasoRuta[] // Todos los pasos que componen esta ruta
}

// 3. Tabla intermedia que da el ORDEN exacto a los pictogramas en una ruta
model PasoRuta {
  id           Int       @id @default(autoincrement())
  orden        Int       // 1, 2, 3... (El orden en el carrusel de Angular)
  
  rutaId       Int
  ruta         Ruta     @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  
  idPictograma  Int
  pictograma    Pictograma @relation(fields: [idPictograma], references: [id])

  // Evita que haya dos "pasos 1" en la misma ruta
  @@unique([rutaId, orden]) 
}

//Cosas Rutas PRUEBA
model Nodo {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique // ej: "ent-principal", "esquina-1", "rayos-x"
  nombre      String   // ej: "Entrada Principal", "Pasillo Central", "Rayos X"
  esDestino   Boolean  @default(false) // true si aparece en el selector del usuario
  aristasOut  Arista[] @relation("NodoOrigen")
  aristasIn   Arista[] @relation("NodoDestino")
}

model Arista {
  id          Int      @id @default(autoincrement())
  origenId    Int
  destinoId   Int
  distancia   Float    @default(1) // Peso para calcular la ruta más corta
  accesible   Boolean  @default(true) // false si tiene escaleras
  origen      Nodo     @relation("NodoOrigen", fields: [origenId], references: [id])
  destino     Nodo     @relation("NodoDestino", fields: [destinoId], references: [id])
  tramos      Tramo[]
}

model Tramo {
  id            Int    @id @default(autoincrement())
  aristaId      Int
  orden         Int    // 1, 2, 3 (orden en que salen las fotos en ese pasillo)
  imagenUrl     String // ej: "/assets/recorridos/pasillo1_01.webp"
  pictogramaUrl String // ej: "/assets/pictogramas/seguir_recto.png"
  instruccion   String // ej: "Camina recto por el pasillo amarillo"
  arista        Arista @relation(fields: [aristaId], references: [id])
}