generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Pictograma {
  id        Int     @id @default(autoincrement())
  titulo    String
  imagenUrl String

  tramos    Tramo[] // Relación con los tramos de Dijkstra
}

model Nodo {
  id        String   @id
  nombre    String
  piso      Int
  esDestino Boolean  @default(false)

  aristasOrigen  Arista[] @relation("NodoOrigen")
  aristasDestino Arista[] @relation("NodoDestino")
}

model Arista {
  id        Int     @id @default(autoincrement())
  origenId  String
  destinoId String
  distancia Float
  accesible Boolean @default(true)

  origen  Nodo @relation("NodoOrigen", fields: [origenId], references: [id])
  destino Nodo @relation("NodoDestino", fields: [destinoId], references: [id])

  tramos Tramo[]
}

model Tramo {
  id           Int    @id @default(autoincrement())
  aristaId     Int
  orden        Int
  imagenUrl    String
  instruccion  String
  idPictograma Int

  arista     Arista     @relation(fields: [aristaId], references: [id], onDelete: Cascade)
  pictograma Pictograma @relation(fields: [idPictograma], references: [id], onDelete: Restrict)
}