{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "imagenes",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/imagenes/**", "/icons/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-recorridos",
      "urls": ["/api/recorridos**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "30d",
        "timeout": "3s"
      }
    }
  ]
}
